{
	"name": "pinx-nuxt-kit",
	"version": "1.12.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "nuxt dev",
		"build": "nuxt build",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"test:unit": "vitest",
		"test:e2e": "start-server-and-test preview http://localhost:3000/ 'cypress run --e2e'",
		"test:e2e:dev": "start-server-and-test preview http://localhost:3000/ 'cypress open --e2e'",
		"type-check": "vue-tsc --build --force",
		"lint": "eslint . --fix",
		"tailwind-config-viewer": "tailwind-config-viewer -o",
		"design-tokens": "node scripts/tokens-tool.js",
		"libs-check": "taze",
		"libs-reload": "rm -rf node_modules package-lock.json && npm install",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@fontsource/jetbrains-mono": "^5.0.20",
		"@fontsource/lexend": "^5.0.20",
		"@fontsource/public-sans": "^5.0.18",
		"@popperjs/core": "^2.11.8",
		"@vueuse/components": "^10.11.0",
		"@vueuse/core": "^10.11.0",
		"colord": "^2.9.3",
		"dayjs": "^1.11.12",
		"highlight.js": "^11.10.0",
		"lodash": "^4.17.21",
		"mitt": "^3.0.1",
		"naive-ui": "^2.39.0",
		"pinia": "^2.2.0",
		"pinia-plugin-persistedstate": "^3.2.1",
		"vue": "^3.4.35",
		"vue-advanced-cropper": "^2.8.9",
		"vue-highlight-words": "^3.0.1",
		"vue-router": "^4.4.2"
	},
	"devDependencies": {
		"@css-render/vue3-ssr": "^0.15.14",
		"@clack/prompts": "^0.7.0",
		"@iconify/vue": "^4.1.2",
		"@nuxt/devtools": "^1.3.9",
		"@nuxt/test-utils": "^3.14.0",
		"@nuxtjs/device": "^3.1.1",
		"@nuxtjs/i18n": "^8.3.3",
		"@nuxtjs/tailwindcss": "^6.12.1",
		"@pinia-plugin-persistedstate/nuxt": "^1.2.1",
		"@pinia/nuxt": "^0.5.2",
		"@types/dom-view-transitions": "^1.0.5",
		"@types/fs-extra": "^11.0.4",
		"@types/inquirer": "^9.0.7",
		"@types/jsdom": "^21.1.7",
		"@types/lodash": "^4.17.7",
		"@types/node": "^22.0.2",
		"@vue/eslint-config-prettier": "^9.0.0",
		"@vue/eslint-config-typescript": "^13.0.0",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.5.1",
		"autoprefixer": "^10.4.19",
		"cypress": "^13.13.2",
		"eslint": "^9.8.0",
		"eslint-plugin-cypress": "^3.4.0",
		"eslint-plugin-vue": "^9.27.0",
		"fs-extra": "^11.2.0",
		"globals": "^15.8.0",
		"jsdom": "^24.1.1",
		"npm-run-all2": "^6.2.2",
		"nuxt": "^3.12.4",
		"nuxt-svgo": "^4.0.2",
		"nuxtjs-naive-ui": "^1.0.2",
		"postcss": "^8.4.40",
		"prettier": "^3.3.3",
		"sass": "^1.77.8",
		"start-server-and-test": "^2.0.5",
		"tailwind-config-viewer": "^2.0.4",
		"tailwindcss": "^3.4.7",
		"taze": "^0.16.3",
		"ts-node": "^10.9.2",
		"type-fest": "^4.23.0",
		"typescript": "~5.5.4",
		"vitest": "^2.0.5",
		"vue-tsc": "^2.0.29"
	},
	"overrides": {
		"@vue/eslint-config-typescript": {
			"eslint": "^9.8.0"
		},
		"@typescript-eslint/type-utils": {
			"eslint": "^9.8.0"
		},
		"@nuxt/test-utils": {
			"vitest": "^2.0.5"
		},
		"ws": "^8.18.0"
	},
	"pnpm": {
		"overrides": {
			"@vue/eslint-config-typescript>eslint": "$eslint",
			"@typescript-eslint/type-utils>eslint": "$eslint",
			"@typescript-eslint/eslint-plugin>eslint": "$eslint",
			"@typescript-eslint/parser>eslint": "$eslint",
			"@typescript-eslint/utils>eslint": "$eslint"
		}
	},
	"engines": {
		"node": ">=18.0.0"
	}
}